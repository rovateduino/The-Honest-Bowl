# RESEND_API_KEY: Required for email sending via Resend (legacy).
RESEND_API_KEY="re_YOUR_API_KEY_HERE"

# RESEND_FROM_EMAIL: Sender email address (e.g., 'onboarding@resend.dev' for testing, or your verified domain email like 'contato@send.thehonestbowl.com')
RESEND_FROM_EMAIL="onboarding@resend.dev"

# BREVO_API_KEY: Required for email sending via Brevo (recommended).
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"

# BREVO_SENDER_EMAIL: Verified sender email in your Brevo account.
BREVO_SENDER_EMAIL="contato@send.thehonestbowl.com"

# SITE_URL: Your production site URL (used in email links).
SITE_URL="https://thehonestbowl.com"

# EBOOK_PDF_BASE64: (Optional) Base64-encoded ebook PDF for email attachment.
# EBOOK_PDF_BASE64="JVBERi0xLjQKJeL..."

# STRIPE_CHECKOUT_URL: Stripe payment link for checkout redirect.
STRIPE_CHECKOUT_URL="https://buy.stripe.com/YOUR_PAYMENT_LINK"

# FIREBASE_*: Firebase configuration (loaded client-side via VITE_ prefix).
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

